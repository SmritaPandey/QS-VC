# Root-only shell environment, chmod 600. Values must be shell-quoted when necessary.
QSVC_DOMAIN=vc.example.internal
SFU_ANNOUNCED_IP=10.0.0.10
QSVC_TLS_CERT=/root/certs/fullchain.pem
QSVC_TLS_KEY=/root/certs/key.pem
# local installs native PostgreSQL+Redis packages; existing uses provided endpoints.
QSVC_DATABASE_MODE=existing
QSVC_INSTALL_PACKAGES=no
AUTH_DATABASE_URL='postgresql://qs_auth_app:URL_ENCODED_PASSWORD@db.example.internal:5432/qsvc'
MEETING_DATABASE_URL='postgresql://qs_meeting_app:URL_ENCODED_PASSWORD@db.example.internal:5432/qsvc'
REDIS_URL='redis://127.0.0.1:6379'
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
POSTGRES_SSL=verify-full
POSTGRES_CA_FILE=/root/certs/database-ca.pem
# Explicit migration opt-in; never use app credentials for migrations.
QSVC_APPLY_MIGRATIONS=no
MIGRATION_DATABASE_URL=''
# Use existing reachable TURN and optional AWS S3 recording configuration.
TURN_SERVERS='turn:turn.example.internal:3478'
TURN_USERNAME=''
TURN_PASSWORD=''
RECORDING_BUCKET=''
AWS_REGION='ap-south-1'
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
