# QS-VC Server Setup — answers for silent installation.
#   sudo ./qsvc-server-setup-<version>.run -- --silent --answers /root/qsvc-answers.env
# Keep this file and the password file root-only (chmod 600). Only these keys are read.
QSVC_ACCEPT_EULA=yes
QSVC_ORG_NAME=Example Department
QSVC_DOMAIN=vc.example.gov.in
QSVC_SERVER_IP=10.10.1.20
QSVC_ADMIN_EMAIL=it-admin@example.gov.in
# File whose first line is the administrator password (at least 12 characters)
QSVC_ADMIN_PASSWORD_FILE=/root/qsvc-admin-password.txt
# internal = QS-VC creates its own certificate authority; organisation = use your certificate
QSVC_TLS_MODE=organisation
QSVC_TLS_CERT=/root/certs/vc.example.gov.in-fullchain.pem
QSVC_TLS_KEY=/root/certs/vc.example.gov.in-key.pem
# The two release key fingerprints QS-VC gave you separately: "<ed25519 sha256>,<ml-dsa-65 sha256>"
QSVC_TRUST_FINGERPRINTS=
