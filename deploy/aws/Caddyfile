{$DOMAIN} {
    encode zstd gzip
    tls {
        curves x25519mlkem768 x25519
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    route {
        @notFromEdge expression size({env.ORIGIN_AUTH_SECRET}) < 32 || {http.request.header.X-QSVC-Origin} != {env.ORIGIN_AUTH_SECRET}
    respond @notFromEdge "Forbidden" 403
    handle /health {
        respond "QS-VC backend gateway" 200
    }
    handle /api/auth/* {
        reverse_proxy 127.0.0.1:4002
    }
    @meetings path /api/meetings /api/meetings/* /api/users/* /api/admin/*
    handle @meetings {
        reverse_proxy 127.0.0.1:4003
    }
    @recording path /api/recordings /api/recordings/*
    handle @recording {
        reverse_proxy 127.0.0.1:4004
    }
    @signaling path /ws /api/ice-servers /api/signaling-ticket
    handle @signaling {
        reverse_proxy 127.0.0.1:4001 {
            header_up X-QSVC-Client-IP {http.request.remote.host}
        }
    }
    handle {
        reverse_proxy 127.0.0.1:8080
    }
    }
}
