{
    "version": 2,
    "buildCommand": "cd frontend/web && npm install && npx vite build",
    "outputDirectory": "frontend/web/dist",
    "installCommand": "echo 'skip root install'",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}