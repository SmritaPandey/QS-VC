# Copy to deploy/aws/gpu/.env (mode 0600) on the GPU instance. Never commit the real file.
# Shared secrets: ASR_API_KEY must equal the backend's ASR_API_KEY;
# MT_API_KEY must equal the backend's LIBRETRANSLATE_API_KEY.
ASR_API_KEY=REPLACE_WITH_RANDOM_SECRET
MT_API_KEY=REPLACE_WITH_RANDOM_SECRET
# Hugging Face read token (accept the terms of ai4bharat/indic-conformer-600m-multilingual first)
HF_TOKEN=
ASR_ENGINE=hybrid
ASR_MODEL=large-v3-turbo
ASR_MAX_PARALLEL=4
ASR_PROMPT=QS-VC, UPSWAN, UPDESCO
MT_BEAMS=3
