# Copy to deploy/aws/cpu/.env (chmod 600) on the AI instance. Never commit the real file.
# Shared secrets: ASR_API_KEY = backend ASR_API_KEY;  MT_API_KEY = backend LIBRETRANSLATE_API_KEY
ASR_API_KEY=REPLACE_WITH_RANDOM_SECRET
MT_API_KEY=REPLACE_WITH_RANDOM_SECRET
# Whisper on CPU: "small" (better) or "base" (faster). Hindi and English work best on CPU.
ASR_MODEL=small
ASR_LANGUAGES=en,hi
MT_LANGUAGES=en,hi,bn,ta,te,mr,gu,kn,ml,pa,or,ur
