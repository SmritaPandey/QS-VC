# Copy to deploy/e2e/.env (chmod 600) on the E2E GPU node. Never commit the real file.
AI_DOMAIN=ai.qsvcmeet.com
# Public IP(s) of the QS-VC backend (AWS Elastic IP). Space separated.
ALLOWED_IPS=REPLACE_WITH_BACKEND_ELASTIC_IP
# Shared secrets — same values on the backend (ASR_API_KEY, LIBRETRANSLATE_API_KEY)
ASR_API_KEY=REPLACE_WITH_RANDOM_SECRET
MT_API_KEY=REPLACE_WITH_RANDOM_SECRET
# Hugging Face read token (accept the ai4bharat/indic-conformer-600m-multilingual terms first)
HF_TOKEN=
ASR_ENGINE=hybrid
ASR_MODEL=large-v3-turbo
ASR_MAX_PARALLEL=4
MT_BEAMS=3
