DOMAIN=backend.qsvcmeet.com
WEB_URL=https://qsvcmeet.com
CORS_ORIGINS=https://qsvcmeet.com,https://www.qsvcmeet.com
NODE_ENV=production
# URL-encode passwords; enter privately. Runtime containers receive only their own URL.
AUTH_DATABASE_URL=postgresql://qs_auth_app:ENCODED_PASSWORD@qs-db.c7kqqqyaeqy2.ap-south-1.rds.amazonaws.com:5432/qsvc
MEETING_DATABASE_URL=postgresql://qs_meeting_app:ENCODED_PASSWORD@qs-db.c7kqqqyaeqy2.ap-south-1.rds.amazonaws.com:5432/qsvc
# Do NOT put the administrator (migration) URL here. The deploy reads it from SSM Parameter
# Store (/qsvc/production/migration-database-url) only while migrations run.
DB_APPLICATION_NAME=qsvc-cloud-demo
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTH_PORT=4002
MEETING_PORT=4003
SIGNALING_PORT=4001
SFU_PORT=4000
AUTH_INTERNAL_URL=http://127.0.0.1:4002
SFU_INTERNAL_URL=http://127.0.0.1:4000
SFU_ANNOUNCED_IP=REPLACE_WITH_ELASTIC_IP
SFU_NUM_WORKERS=1
SFU_MIN_PORT=40000
SFU_MAX_PORT=40100
# Shared by the signaling and SFU containers only. Generated automatically on the first
# deploy if missing; set your own random value here if you prefer.
SFU_CONTROL_TOKEN=REPLACE_WITH_RANDOM_SECRET
# Shared secret between coturn and the auth service; browsers get 1-hour HMAC credentials.
TURN_SECRET=REPLACE_WITH_RANDOM_SECRET
TURN_SERVERS=turn:backend.qsvcmeet.com:3478?transport=udp,turn:backend.qsvcmeet.com:3478?transport=tcp

# Explicit enterprise approvals; do not include passwords. Empty denies access.
ENTERPRISE_ACCESS_JSON=[]

# Private S3 bucket from the backend stack output; uses the instance IAM role.
RECORDING_BUCKET=REPLACE_WITH_STACK_RECORDING_BUCKET

# ── Multilingual captions (GPU host from deploy/aws/gpu, same VPC, private IP) ──
# Leave ASR_URL empty to keep browser speech recognition.
ASR_URL=http://REPLACE_WITH_GPU_PRIVATE_IP:8000
ASR_API_KEY=REPLACE_WITH_RANDOM_SECRET_SAME_AS_GPU_HOST
CAPTION_TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=http://REPLACE_WITH_GPU_PRIVATE_IP:5000
LIBRETRANSLATE_API_KEY=REPLACE_WITH_RANDOM_SECRET_SAME_AS_GPU_HOST
# AI minutes: OpenRouter (https://openrouter.ai/api/v1) or Ollama on the GPU host (http://GPU_PRIVATE_IP:11434/v1)
MINUTES_LLM_URL=
MINUTES_LLM_MODEL=
MINUTES_LLM_API_KEY=
