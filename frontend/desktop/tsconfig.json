{
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "module": "commonjs",
        "target": "ES2020",
        "moduleResolution": "node",
        "ignoreDeprecations": "5.0",
        "esModuleInterop": true,
        "declaration": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts"
    ]
}
