set -euo pipefail

# ── Color Output Formatting ──────────────────────────────────────────────────
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; NC=''
fi

info()  { echo -e "${CYAN}❯${NC} $*"; }
ok()    { echo -e "${GREEN}✔${NC} $*"; }
warn()  { echo -e "${YELLOW}▲${NC} $*"; }
err()   { echo -e "${RED}✖${NC} $*" >&2; }
die()   { err "$*"; exit 1; }

# ── Bundle and Script Path Discovery ─────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$SCRIPT_DIR"
CONFIG_DIR="$ROOT_DIR/config"
COMPOSE_DIR="$ROOT_DIR/compose"
ENV_FILE="$CONFIG_DIR/.env"

VERSION="1.0.0"

# ── Banner ───────────────────────────────────────────────────────────────────
banner() {
    cat << "EOF"
  ██████╗ ███████╗      ██╗   ██╗ ██████╗
 ██╔═══██╗██╔════╝      ██║   ██║██╔════╝
 ██║   ██║███████╗█████╗██║   ██║██║     
 ██║▄▄ ██║╚════██║╚════╝╚██╗ ██╔╝██║     
 ╚██████╔╝███████║       ╚████╔╝ ╚██████╗
  ╚══▀▀═╝ ╚══════╝        ╚═══╝   ╚═════╝
 Enterprise On-Premises Communication Platform
EOF
    echo -e "${BOLD}Version: ${VERSION}${NC}\n"
}

# ── Compose Command Helper ───────────────────────────────────────────────────
compose_cmd() {
    local profile="${1:-single-box}"
    local file="$COMPOSE_DIR/single-box.yml"
    
    if [ "$profile" = "core" ]; then
        file="$COMPOSE_DIR/core.yml"
    elif [ "$profile" = "ai" ]; then
        file="$COMPOSE_DIR/ai.yml"
    elif [ "$profile" = "mcu" ]; then
        file="$COMPOSE_DIR/mcu.yml"
    fi

    if docker compose version &>/dev/null; then
        docker compose -f "$file" --env-file "$ENV_FILE" "${@:2}"
    else
        docker-compose -f "$file" --env-file "$ENV_FILE" "${@:2}"
    fi
}

# ── Database Query Helper ────────────────────────────────────────────────────
get_pg_container() {
    if docker ps --format '{{.Names}}' | grep -q 'qsvc-postgres'; then
        echo "qsvc-postgres"
    elif docker ps --format '{{.Names}}' | grep -q 'qsvc-pg'; then
        echo "qsvc-pg"
    else
        echo ""
    fi
}

db_query() {
    local sql="$1"
    local c
    c=$(get_pg_container)
    if [ -n "$c" ]; then
        docker exec -i "$c" psql -U "${POSTGRES_USER:-qsvc}" -d "${POSTGRES_DB:-qsvc}" -t -A -c "$sql"
    else
        die "PostgreSQL container (qsvc-postgres or qsvc-pg) is not currently running."
    fi
}

