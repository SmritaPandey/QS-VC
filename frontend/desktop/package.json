{
    "name": "@qsvc/desktop",
    "version": "1.1.0",
    "private": true,
    "description": "QS-VC Desktop Client for organisation intranets",
    "main": "dist/main.js",
    "scripts": {
        "build": "node scripts/vendor-shared.cjs && tsc",
        "start": "electron .",
        "dev": "npm run build && electron .",
        "package:win": "npm run package:win:x64",
        "package:mac": "electron-builder --mac",
        "package:mac:arm64": "npm run build && electron-builder --mac zip --arm64",
        "package:mac:x64": "npm run build && electron-builder --mac zip --x64",
        "package:linux": "npm run package:linux:x64",
        "package:linux:x64": "npm run build && electron-builder --linux zip --x64",
        "package:win:x64": "npm run build && electron-builder --win zip --x64"
    },
    "build": {
        "appId": "com.qsvc.desktop",
        "productName": "QS-VC",
        "copyright": "QS-VC",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "static/**/*",
            "assets/**/*",
            "package.json"
        ],
        "protocols": [
            {
                "name": "QS-VC meeting link",
                "schemes": [
                    "qsvc"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "assets/icon.ico",
            "signAndEditExecutable": false,
            "artifactName": "QS-VC-Windows-${arch}.zip"
        },
        "linux": {
            "target": [
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "assets/icon.png",
            "category": "Network",
            "artifactName": "QS-VC-Linux-${arch}.zip",
            "executableName": "qs-vc-bin"
        },
        "mac": {
            "target": [
                {
                    "target": "zip",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ],
            "icon": "assets/icon.png",
            "category": "public.app-category.video",
            "artifactName": "QS-VC-macOS-${arch}.zip",
            "identity": null,
            "hardenedRuntime": false,
            "gatekeeperAssess": false,
            "extendInfo": {
                "NSCameraUsageDescription": "QS-VC uses your camera for video meetings.",
                "NSMicrophoneUsageDescription": "QS-VC uses your microphone for video meetings."
            }
        },
        "afterPack": "scripts/after-pack.cjs"
    },
    "devDependencies": {
        "electron": "45.2.3",
        "electron-builder": "26.18.0",
        "typescript": "^5.7.0"
    },
    "author": "QS-VC",
    "allowScripts": {
        "electron@45.2.3": true
    }
}
