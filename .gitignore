# On-prem release & workspace safety
Claude outputs/
.venv*/
certs/*.pem
release/

/installers/*.zip
/installers/*.sha256

# Distribute release binaries through release storage, not source control.
/deploy/aws/outgoing/

# Track the on-prem release tooling while keeping generated payloads ignored.
!/deploy/vc-onprem/release/
/deploy/vc-onprem/release/*
!/deploy/vc-onprem/release/*.sh
!/deploy/vc-onprem/release/manifest.py
!/deploy/vc-onprem/release/*.md
!/deploy/vc-onprem/release/VERSION

/deploy/aws/license-private/

# Generated On-prem release archives and private key material
/deploy/aws/installers/*.tar.gz
*.pem
*.key
