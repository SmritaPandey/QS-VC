{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qs-vc",
  "main": "deploy/cloudflare/worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
"vars": {
    "BACKEND_ORIGIN": "https://backend.qsvcmeet.com",
    "QSVC_EC2_INSTANCE_ID": "i-06746b0582544f1c6",
    "QSVC_DEPLOY_ROLE_ARN": "arn:aws:iam::173535830454:role/QSVCGitHubDeployRole",
    "QSVC_DEPLOY_BUCKET": "qsvc-deploy-artifacts-173535830454"
  },
  "routes": [
    { "pattern": "qsvcmeet.com", "custom_domain": true },
    { "pattern": "www.qsvcmeet.com", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build:web"
  },
  "assets": {
    "directory": "./frontend/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/ws", "/ws/*"],
    "not_found_handling": "single-page-application"
  }
}
