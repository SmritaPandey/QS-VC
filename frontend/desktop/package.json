{
    "name": "@qsvc/desktop",
    "version": "1.1.0",
    "private": true,
    "description": "QS-VC Desktop Client for organisation intranets",
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc",
        "start": "electron .",
        "dev": "tsc && electron .",
        "package:win": "electron-builder --win",
        "package:mac": "electron-builder --mac",
        "package:mac:arm64": "npm run build && electron-builder --mac zip --arm64",
        "package:mac:x64": "npm run build && electron-builder --mac zip --x64",
        "package:linux": "electron-builder --linux"
    },
    "build": {
        "appId": "com.qsvc.desktop",
        "productName": "QS-VC",
        "copyright": "QS-VC",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "static/**/*",
            "assets/**/*",
            "package.json"
        ],
        "protocols": [
            {
                "name": "QS-VC meeting link",
                "schemes": [
                    "qsvc"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "assets/icon.ico",
            "signAndEditExecutable": false,
            "artifactName": "QS-VC-Windows-Setup.exe"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "QS-VC",
            "installerIcon": "assets/icon.ico",
            "uninstallerIcon": "assets/icon.ico",
            "uninstallDisplayName": "QS-VC"
        },
        "linux": {
            "target": [
                "dir"
            ],
            "icon": "assets/icon.png",
            "category": "Network"
        },
        "mac": {
            "target": [
                {
                    "target": "zip",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ],
            "icon": "assets/icon.png",
            "category": "public.app-category.video",
            "artifactName": "QS-VC-macOS-${arch}.zip",
            "identity": null,
            "hardenedRuntime": false,
            "gatekeeperAssess": false,
            "extendInfo": {
                "NSCameraUsageDescription": "QS-VC uses your camera for video meetings.",
                "NSMicrophoneUsageDescription": "QS-VC uses your microphone for video meetings."
            }
        }
    },
    "dependencies": {},
    "devDependencies": {
        "electron": "33.4.11",
        "electron-builder": "25.1.8",
        "typescript": "^5.7.0"
    },
    "author": "QS-VC",
    "allowScripts": {
        "electron@33.4.11": true
    }
}
