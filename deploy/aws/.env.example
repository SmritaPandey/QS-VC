DOMAIN=qsvcmeet.com
WEB_URL=https://qsvcmeet.com
CORS_ORIGINS=https://qsvcmeet.com
NODE_ENV=production
# URL-encode passwords; enter privately. Runtime containers receive only their own URL.
AUTH_DATABASE_URL=postgresql://qs_auth_app:ENCODED_PASSWORD@qs-db.c7kqqqyaeqy2.ap-south-1.rds.amazonaws.com:5432/qsvc
MEETING_DATABASE_URL=postgresql://qs_meeting_app:ENCODED_PASSWORD@qs-db.c7kqqqyaeqy2.ap-south-1.rds.amazonaws.com:5432/qsvc
# Administrator URL is for the maintenance container only; omit between migrations.
MIGRATION_DATABASE_URL=
DB_APPLICATION_NAME=qsvc-cloud-demo
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTH_PORT=4002
MEETING_PORT=4003
SIGNALING_PORT=4001
SFU_PORT=4000
AUTH_INTERNAL_URL=http://127.0.0.1:4002
SFU_INTERNAL_URL=http://127.0.0.1:4000
SFU_ANNOUNCED_IP=REPLACE_WITH_ELASTIC_IP
SFU_NUM_WORKERS=1
SFU_MIN_PORT=40000
SFU_MAX_PORT=40100
TURN_USERNAME=qsvc-demo
TURN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
TURN_SERVERS=turn:qsvcmeet.com:3478?transport=udp,turn:qsvcmeet.com:3478?transport=tcp

# Explicit enterprise approvals; do not include passwords. Empty denies access.
ENTERPRISE_ACCESS_JSON=[]
