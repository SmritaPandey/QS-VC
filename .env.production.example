# QS-VC production intranet environment variables.
# Copy to .env.production, generate unique secrets, and keep it out of the release archive.

# Split-horizon DNS name that resolves to this server on the enterprise network.
DOMAIN=meet.yourdomain.com

# Database
POSTGRES_DB=qsvc
POSTGRES_USER=qsvc_db_admin
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_DB_ADMIN_SECRET

# Create these LOGIN roles with db/create-application-accounts.sql after the
# database migrations have run. Keep the passwords unique and separate.
AUTH_DB_USER=qs_auth_app
AUTH_DB_PASSWORD=REPLACE_WITH_UNIQUE_AUTH_DB_SECRET
MEETING_DB_USER=qs_meeting_app
MEETING_DB_PASSWORD=REPLACE_WITH_UNIQUE_MEETING_DB_SECRET

# Redis
REDIS_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_REDIS_SECRET

# JWT
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# Payments are off until merchant terms and provider plans are approved.
PAYMENTS_ENABLED=false
PAYMENT_TERMS_CONFIRMED=false
PAYMENT_RETURN_URL=https://meet.yourdomain.com
AUTH_PUBLIC_URL=https://api.yourdomain.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_STARTER_TRIAL=
PAYPAL_PLAN_PRO_TRIAL=
PAYPAL_CURRENCY=USD
PAYPAL_STARTER_BASE_AMOUNT=
PAYPAL_PRO_BASE_AMOUNT=
CASHFREE_ENVIRONMENT=production
CASHFREE_API_VERSION=2026-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=

# TURN Server
TURN_SECRET=REPLACE_WITH_UNIQUE_RANDOM_TURN_SECRET
# LAN address reachable by every meeting client, not a public IP for intranet-only deployments.
SFU_ANNOUNCED_IP=YOUR_SERVER_LAN_IP
SFU_CONTROL_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_SFU_CONTROL_SECRET

# MinIO / S3
MINIO_ACCESS_KEY=REPLACE_WITH_UNIQUE_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_MINIO_SECRET

# CORS
CORS_ORIGINS=https://meet.yourdomain.com

# AI Services (Optional)
HF_TOKEN=
MINUTES_LLM_URL=https://openrouter.ai/api/v1
MINUTES_LLM_API_KEY=

# Platform Admins (Required for on-prem)
QSVC_ADMIN_EMAILS=admin@yourdomain.com

