<!--
  Auto-generated by `qsvcctl devices sync`. Do NOT edit by hand.
  Copy to /etc/freeswitch/directory/qsvc-devices.xml after generation.

  Template variables (populated per enabled device from the devices table):
    {{extension}}   - SIP extension / user id (numeric, matches room_devices.extension)
    {{sip_password}} - SIP registration password for this device
    {{caller_name}} - Display name shown in conferences (e.g. "Boardroom 401")
-->
<include>
  <domain name="qsvc-rooms">
    <params>
      <param name="dial-string" value="{^^:sip_invite_domain=${dialed_domain}:presence_id=${dialed_user}@${dialed_domain}}${sofia_contact(*/${dialed_user}@${dialed_domain})}"/>
    </params>
    <groups>
      <group name="devices">
        <users>
          <!-- BEGIN GENERATED DEVICE ENTRIES -->
          {{#each devices}}
          <user id="{{this.extension}}">
            <params>
              <param name="password" value="{{this.sip_password}}"/>
              <param name="vm-enabled" value="false"/>
            </params>
            <variables>
              <variable name="user_context" value="qsvc-rooms"/>
              <variable name="effective_caller_id_name" value="{{this.caller_name}}"/>
              <variable name="effective_caller_id_number" value="{{this.extension}}"/>
              <variable name="accountcode" value="qsvc-device"/>
            </variables>
          </user>
          {{/each}}
          <!-- END GENERATED DEVICE ENTRIES -->
        </users>
      </group>
    </groups>
  </domain>
</include>
